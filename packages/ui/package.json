{
    "name": "ui",
    "version": "0.1.1",
    "private": true,
    "description": "GitHub-style local git diff review UI.",
    "author": "Gus Canto",
    "repository": {
        "type": "git",
        "url": "https://github.com/oullin/git-diff.git",
        "directory": "packages/ui"
    },
    "type": "module",
    "main": "dist-electron/main.js",
    "imports": {
        "#electron/*.js": {
            "types": "./electron/*.ts",
            "default": "./dist-electron/*.js"
        },
        "#scripts/*.js": "./scripts/*.ts"
    },
    "scripts": {
        "check:typescript": "tsx scripts/check-typescript-only.ts",
        "check:imports": "tsx ../../scripts/check-no-relative-imports.ts src tests electron scripts ../../scripts",
        "dev": "tsx scripts/dev/index.ts",
        "dev:vite": "portless git-diff-ui vite --host 127.0.0.1",
        "dev:electron": "pnpm exec tsc -p tsconfig.electron.json && pnpm exec vite build --config vite.electron.config.ts && VITE_DEV_SERVER_URL=https://git-diff-ui.localhost:1355 electron dist-electron/main.js",
        "build": "pnpm run check:typescript && pnpm run check:imports && vue-tsc --noEmit && vite build && tsc -p tsconfig.electron.json --noEmit && ELECTRON_BUILD_TARGET=main vite build --config vite.electron.config.ts && ELECTRON_BUILD_TARGET=preload vite build --config vite.electron.config.ts",
        "test": "pnpm run check:typescript && pnpm run check:imports && vitest run",
        "start": "electron dist-electron/main.js",
        "package": "electron-forge package",
        "make": "electron-forge make",
        "make:mac": "electron-forge make --platform=darwin --arch=arm64",
        "publish": "electron-forge publish",
        "lint": "oxlint .",
        "icon:generate": "bash scripts/generate-app-icon.sh"
    },
    "dependencies": {
        "@git-diff/bridge": "workspace:*",
        "@git-diff/domain": "workspace:*"
    },
    "devDependencies": {
        "@electron-forge/cli": "^7.11.2",
        "@electron-forge/maker-dmg": "^7.11.2",
        "@electron-forge/maker-zip": "^7.11.2",
        "@electron-forge/publisher-github": "^7.11.2",
        "@lexical/code": "0.38.1",
        "@lexical/html": "0.38.1",
        "@lexical/link": "0.38.1",
        "@lexical/list": "0.38.1",
        "@lexical/markdown": "0.38.1",
        "@lexical/rich-text": "0.38.1",
        "@lexical/selection": "0.38.1",
        "@lexical/table": "0.38.1",
        "@lexical/utils": "0.38.1",
        "@pierre/diffs": "1.2.0-beta.6",
        "@pierre/trees": "1.0.0-beta.3",
        "@primer/primitives": "^11.8.0",
        "@radix-icons/vue": "^1.0.0",
        "@shikijs/themes": "^4.0.2",
        "@tailwindcss/vite": "4.3.0",
        "@types/node": "^25.6.2",
        "@types/web-bluetooth": "0.0.21",
        "@vitejs/plugin-vue": "6.0.6",
        "@vue/test-utils": "2.4.10",
        "@vueuse/core": "^14.3.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "dompurify": "3.4.2",
        "electron": "42.0.1",
        "ghostty-web": "0.4.0",
        "happy-dom": "^20.0.11",
        "lexical": "0.38.1",
        "lexical-vue": "0.14.1",
        "lucide-vue-next": "^1.0.0",
        "marked": "^18.0.4",
        "monaco-editor": "^0.55.1",
        "monaco-yaml": "^5.4.1",
        "pinia": "^3.0.4",
        "portless": "0.13.0",
        "prismjs": "1.30.0",
        "reka-ui": "^2.9.7",
        "shiki": "^4.0.2",
        "tailwind-merge": "^3.4.0",
        "tailwindcss": "4.3.0",
        "tsx": "^4.21.0",
        "typescript": "^6.0.3",
        "vite": "8.0.11",
        "vitest": "4.1.5",
        "vue": "3.5.34",
        "vue-tsc": "^3.2.8"
    }
}

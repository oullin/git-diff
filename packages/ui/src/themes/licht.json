{
    "name": "Licht",
    "colors": {
        "editor.background": "#ffffff",
        "editor.findMatchBackground": "#ffe792",
        "editor.findMatchHighlightBackground": "#ffe79250",
        "editor.foreground": "#252525",
        "editor.inactiveSelectionBackground": "#ececea",
        "editor.lineHighlightBackground": "#f7f7f7",
        "editor.linkedEditingBackground": "#00000000",
        "editor.selectionBackground": "#ececea",
        "editor.selectionHighlightBackground": "#f4f4f3",
        "editor.wordHighlightBackground": "#f4f4f3",
        "editorBracketHighlight.foreground1": "#252525",
        "editorBracketHighlight.foreground2": "#5c5c5c",
        "editorBracketHighlight.foreground3": "#8e8e8e",
        "editorBracketHighlight.foreground4": "#5c5c5c",
        "editorBracketHighlight.foreground5": "#8e8e8e",
        "editorBracketHighlight.unexpectedBracket.foreground": "#ff2e3f",
        "editorCursor.foreground": "#252525",
        "editorLineNumber.activeForeground": "#252525",
        "editorLineNumber.foreground": "#b8b8b8",
        "editorWhitespace.foreground": "#ececea",
        "focusBorder": "#252525",
        "list.activeSelectionBackground": "#f4f4f3",
        "list.activeSelectionForeground": "#252525",
        "list.focusHighlightForeground": "#252525",
        "menu.background": "#ffffff",
        "quickInputList.focusBackground": "#f4f4f3",
        "quickInputList.focusForeground": "#252525",
        "statusBar.background": "#f7f7f7",
        "statusBarItem.remoteBackground": "#252525",
        "textLink.activeForeground": "#252525",
        "textLink.foreground": "#252525"
    },
    "tokenColors": [
        {
            "name": "Comments",
            "scope": ["comment", "comment punctuation"],
            "settings": {
                "foreground": "#919191"
            }
        },
        {
            "name": "Comments: Preprocessor",
            "scope": "comment.block.preprocessor",
            "settings": {
                "foreground": "#adadad"
            }
        },
        {
            "name": "Comments: Documentation",
            "scope": ["comment.documentation", "comment.block.documentation"],
            "settings": {
                "background": "#fffdf7",
                "foreground": "#bc670f"
            }
        },
        {
            "name": "Invalid - Deprecated",
            "scope": "invalid.deprecated",
            "settings": {
                "background": "#990000",
                "foreground": "#ffffff"
            }
        },
        {
            "name": "Invalid - Illegal",
            "scope": "invalid.illegal",
            "settings": {
                "foreground": "#cd3131"
            }
        },
        {
            "name": "Operators",
            "scope": "keyword.operator",
            "settings": {
                "foreground": "#352de3"
            }
        },
        {
            "name": "Keywords",
            "scope": ["keyword", "storage"],
            "settings": {
                "foreground": "#352de3"
            }
        },
        {
            "name": "Types",
            "scope": ["storage.type", "support.type"],
            "settings": {
                "foreground": "#c56e0e"
            }
        },
        {
            "name": "Language Constants",
            "scope": ["constant.language", "variable.language"],
            "settings": {
                "foreground": "#626fc9"
            }
        },
        {
            "name": "Variables",
            "scope": ["variable", "support.variable"],
            "settings": {
                "foreground": "#111111"
            }
        },
        {
            "name": "Variables: Punctuation",
            "scope": "variable punctuation",
            "settings": {
                "foreground": "#111111"
            }
        },
        {
            "name": "Functions",
            "scope": ["entity.name.function", "support.function", "entity"],
            "settings": {
                "foreground": "#284181"
            }
        },
        {
            "name": "Classes",
            "scope": ["entity.name.type", "entity.other.inherited-class", "support.class"],
            "settings": {
                "foreground": "#bb28c7"
            }
        },
        {
            "name": "Exceptions",
            "scope": "entity.name.exception",
            "settings": {
                "foreground": "#f93232"
            }
        },
        {
            "name": "Sections",
            "scope": "entity.name.section",
            "settings": {
                "fontStyle": ""
            }
        },
        {
            "name": "Numbers",
            "scope": ["constant.numeric", "constant"],
            "settings": {
                "foreground": "#dd3c2f"
            }
        },
        {
            "name": "Punctuation",
            "scope": "punctuation",
            "settings": {
                "foreground": "#111111"
            }
        },
        {
            "name": "Strings",
            "scope": ["constant.character", "string"],
            "settings": {
                "foreground": "#00a33f"
            }
        },
        {
            "name": "Strings: Punctuation",
            "scope": "string punctuation",
            "settings": {
                "foreground": "#00a33f"
            }
        },
        {
            "name": "Strings: Escape Sequences",
            "scope": "constant.character.escape",
            "settings": {
                "background": "#fbe9ad44",
                "fontStyle": "bold"
            }
        },
        {
            "name": "Strings: Regular Expressions",
            "scope": "string.regexp",
            "settings": {
                "foreground": "#699d36"
            }
        },
        {
            "name": "Results",
            "scope": "constant.numeric.line-number.bgr",
            "settings": {
                "foreground": "#111111"
            }
        },
        {
            "name": "Strings: Symbols",
            "scope": "constant.other.symbol",
            "settings": {
                "background": "#e8ffd5",
                "fontStyle": "bold"
            }
        },
        {
            "name": "Object Keys",
            "scope": "string.unquoted.label.js",
            "settings": {
                "foreground": "#444444"
            }
        },
        {
            "name": "Quasi Literals",
            "scope": "punctuation.quasi.element",
            "settings": {
                "foreground": "#444444"
            }
        },
        {
            "name": "Embedded Source",
            "scope": ["string source", "text source"],
            "settings": {
                "foreground": "#434343"
            }
        },
        {
            "name": "HTML: Doctype Declaration",
            "scope": "meta.tag.sgml.doctype",
            "settings": {
                "foreground": "#7f7f7f"
            }
        },
        {
            "name": "HTML: Tags",
            "scope": "entity.name.tag",
            "settings": {
                "foreground": "#0072c8"
            }
        },
        {
            "name": "HTML: Attribute Punctuation",
            "scope": "meta.tag string punctuation",
            "settings": {
                "foreground": "#00a33f"
            }
        },
        {
            "name": "HTML: Tag Punctuation",
            "scope": "punctuation.definition.tag",
            "settings": {
                "foreground": "#4f9fcf"
            }
        },
        {
            "name": "HTML: Entities",
            "scope": "constant.character.entity",
            "settings": {
                "foreground": "#111111"
            }
        },
        {
            "name": "HTML: Attribute Names",
            "scope": "entity.other.attribute-name",
            "settings": {
                "foreground": "#0072c8"
            }
        },
        {
            "name": "HTML: Attribute Values",
            "scope": ["meta.tag string.quoted", "meta.tag string.quoted constant.character.entity"],
            "settings": {
                "background": "#ffffff",
                "foreground": "#00a33f"
            }
        },
        {
            "name": "CSS: Selectors",
            "scope": [
                "meta.selector",
                "meta.selector entity",
                "meta.selector entity punctuation",
                "entity.name.tag.css"
            ],
            "settings": {
                "foreground": "#3a77bf"
            }
        },
        {
            "name": "CSS: Property Names",
            "scope": ["meta.property-name", "support.type.property-name"],
            "settings": {
                "foreground": "#111111"
            }
        },
        {
            "name": "JSON: Property Names",
            "scope": ["meta.property-name.json", "support.type.property-name.json"],
            "settings": {
                "foreground": "#00a33f"
            }
        },
        {
            "name": "CSS: Property Values",
            "scope": [
                "meta.property-value constant.numeric",
                "meta.property-value constant",
                "meta.property-value keyword"
            ],
            "settings": {
                "foreground": "#43a202"
            }
        },
        {
            "name": "Markup: Changed",
            "scope": "markup.changed",
            "settings": {
                "background": "#ffffdd",
                "foreground": "#111111"
            }
        },
        {
            "name": "Markup: Deletion",
            "scope": "markup.deleted",
            "settings": {
                "background": "#ffdddd",
                "foreground": "#111111"
            }
        },
        {
            "name": "Markup: Emphasis",
            "scope": "markup.italic",
            "settings": {
                "fontStyle": "italic"
            }
        },
        {
            "name": "Markup: Error",
            "scope": "markup.error",
            "settings": {
                "foreground": "#cd3131"
            }
        },
        {
            "name": "Markup: Insertion",
            "scope": "markup.inserted",
            "settings": {
                "background": "#ddffdd",
                "foreground": "#111111"
            }
        },
        {
            "name": "Markup: Output",
            "scope": ["markup.output", "markup.raw"],
            "settings": {
                "foreground": "#7f7f7f"
            }
        },
        {
            "name": "Markup: Prompt",
            "scope": "markup.prompt",
            "settings": {
                "foreground": "#555555"
            }
        },
        {
            "name": "Markup: Heading",
            "scope": "markup.heading",
            "settings": {
                "fontStyle": "bold"
            }
        },
        {
            "name": "Markup: Strong",
            "scope": "markup.bold",
            "settings": {
                "fontStyle": "bold"
            }
        },
        {
            "name": "Markup: Traceback",
            "scope": "markup.traceback",
            "settings": {
                "foreground": "#f93232"
            }
        },
        {
            "name": "Markup: Underline",
            "scope": "markup.underline",
            "settings": {
                "fontStyle": "underline"
            }
        }
    ]
}

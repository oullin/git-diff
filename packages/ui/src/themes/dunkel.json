{
  "name": "Dunkel",
  "colors": {
    "editor.background": "#181410",
    "editor.findMatchBackground": "#f5b34150",
    "editor.findMatchHighlightBackground": "#f5b34130",
    "editor.foreground": "#e8dcc6",
    "editor.inactiveSelectionBackground": "#d4a57420",
    "editor.lineHighlightBackground": "#3a302520",
    "editor.linkedEditingBackground": "#00000000",
    "editor.selectionBackground": "#d9775760",
    "editor.selectionHighlightBackground": "#d9775730",
    "editorBracketHighlight.foreground1": "#e8dcc6",
    "editorBracketHighlight.foreground2": "#c6b89e",
    "editorBracketHighlight.foreground3": "#8e8067",
    "editorBracketHighlight.foreground4": "#f0a35e",
    "editorBracketHighlight.foreground5": "#fbbf6b",
    "editorBracketHighlight.unexpectedBracket.foreground": "#e76f51",
    "editorCursor.foreground": "#fbbf6b",
    "editorLineNumber.activeForeground": "#e8dcc6",
    "editorLineNumber.foreground": "#6a5d48",
    "editorWhitespace.foreground": "#3a302520",
    "focusBorder": "#d97757",
    "list.activeSelectionBackground": "#3a302540",
    "list.activeSelectionForeground": "#f5ecdc",
    "list.focusHighlightForeground": "#ffffff",
    "menu.background": "#221c16",
    "quickInputList.focusBackground": "#3a302540",
    "quickInputList.focusForeground": "#f5ecdc",
    "statusBar.background": "#1a1611",
    "statusBarItem.remoteBackground": "#1a1611"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "comment punctuation"],
      "settings": {
        "foreground": "#6f6147"
      }
    },
    {
      "name": "Comments: Preprocessor",
      "scope": "comment.block.preprocessor",
      "settings": {
        "foreground": "#8e8067"
      }
    },
    {
      "name": "Comments: Documentation",
      "scope": ["comment.documentation", "comment.block.documentation"],
      "settings": {
        "background": "#fffdf7",
        "foreground": "#d4a574"
      }
    },
    {
      "name": "Invalid - Deprecated",
      "scope": "invalid.deprecated",
      "settings": {
        "background": "#5a1f12",
        "foreground": "#f5ecdc"
      }
    },
    {
      "name": "Invalid - Illegal",
      "scope": "invalid.illegal",
      "settings": {
        "foreground": "#e76f51"
      }
    },
    {
      "name": "Operators",
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#d4a574"
      }
    },
    {
      "name": "Keywords",
      "scope": ["keyword", "storage"],
      "settings": {
        "foreground": "#f0a35e"
      }
    },
    {
      "name": "Types",
      "scope": ["storage.type", "support.type"],
      "settings": {
        "foreground": "#fcd884"
      }
    },
    {
      "name": "Language Constants",
      "scope": ["constant.language", "variable.language"],
      "settings": {
        "foreground": "#f0a35e"
      }
    },
    {
      "name": "Variables",
      "scope": ["variable", "support.variable"],
      "settings": {
        "foreground": "#e8dcc6"
      }
    },
    {
      "name": "Variables: Punctuation",
      "scope": "variable punctuation",
      "settings": {
        "foreground": "#8e8067"
      }
    },
    {
      "name": "Functions",
      "scope": ["entity.name.function", "support.function", "entity"],
      "settings": {
        "foreground": "#fbbf6b"
      }
    },
    {
      "name": "Classes",
      "scope": ["entity.name.type", "entity.other.inherited-class", "support.class"],
      "settings": {
        "foreground": "#fcd884"
      }
    },
    {
      "name": "Exceptions",
      "scope": "entity.name.exception",
      "settings": {
        "foreground": "#e76f51"
      }
    },
    {
      "name": "Sections",
      "scope": "entity.name.section",
      "settings": {
        "fontStyle": ""
      }
    },
    {
      "name": "Numbers",
      "scope": ["constant.numeric", "constant"],
      "settings": {
        "foreground": "#e87a4d"
      }
    },
    {
      "name": "Punctuation",
      "scope": "punctuation",
      "settings": {
        "foreground": "#8e8067"
      }
    },
    {
      "name": "Strings",
      "scope": ["constant.character", "string"],
      "settings": {
        "foreground": "#b6d167"
      }
    },
    {
      "name": "Strings: Punctuation",
      "scope": "string punctuation",
      "settings": {
        "foreground": "#b6d167"
      }
    },
    {
      "name": "Strings: Escape Sequences",
      "scope": "constant.character.escape",
      "settings": {
        "background": "#fbe9ad44",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Strings: Regular Expressions",
      "scope": "string.regexp",
      "settings": {
        "foreground": "#b6d167"
      }
    },
    {
      "name": "Results",
      "scope": "constant.numeric.line-number.bgr",
      "settings": {
        "foreground": "#e8dcc6"
      }
    },
    {
      "name": "Strings: Symbols",
      "scope": "constant.other.symbol",
      "settings": {
        "background": "#e8ffd5",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Object Keys",
      "scope": "string.unquoted.label.js",
      "settings": {
        "foreground": "#fcd884"
      }
    },
    {
      "name": "Quasi Literals",
      "scope": "punctuation.quasi.element",
      "settings": {
        "foreground": "#8e8067"
      }
    },
    {
      "name": "Embedded Source",
      "scope": ["string source", "text source"],
      "settings": {
        "foreground": "#c6b89e"
      }
    },
    {
      "name": "HTML: Doctype Declaration",
      "scope": "meta.tag.sgml.doctype",
      "settings": {
        "foreground": "#8e8067"
      }
    },
    {
      "name": "HTML: Tags",
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#fbbf6b"
      }
    },
    {
      "name": "HTML: Attribute Punctuation",
      "scope": "meta.tag string punctuation",
      "settings": {
        "foreground": "#b6d167"
      }
    },
    {
      "name": "HTML: Tag Punctuation",
      "scope": "punctuation.definition.tag",
      "settings": {
        "foreground": "#d4a574"
      }
    },
    {
      "name": "HTML: Entities",
      "scope": "constant.character.entity",
      "settings": {
        "foreground": "#e87a4d"
      }
    },
    {
      "name": "HTML: Attribute Names",
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#fcd884"
      }
    },
    {
      "name": "HTML: Attribute Values",
      "scope": ["meta.tag string.quoted", "meta.tag string.quoted constant.character.entity"],
      "settings": {
        "background": "#ffffff",
        "foreground": "#b6d167"
      }
    },
    {
      "name": "CSS: Selectors",
      "scope": [
        "meta.selector",
        "meta.selector entity",
        "meta.selector entity punctuation",
        "entity.name.tag.css"
      ],
      "settings": {
        "foreground": "#fbbf6b"
      }
    },
    {
      "name": "CSS: Property Names",
      "scope": ["meta.property-name", "support.type.property-name"],
      "settings": {
        "foreground": "#fcd884"
      }
    },
    {
      "name": "JSON: Property Names",
      "scope": ["meta.property-name.json", "support.type.property-name.json"],
      "settings": {
        "foreground": "#fcd884"
      }
    },
    {
      "name": "CSS: Property Values",
      "scope": [
        "meta.property-value constant.numeric",
        "meta.property-value constant",
        "meta.property-value keyword"
      ],
      "settings": {
        "foreground": "#b6d167"
      }
    },
    {
      "name": "Markup: Changed",
      "scope": "markup.changed",
      "settings": {
        "background": "#ffffdd",
        "foreground": "#e8dcc6"
      }
    },
    {
      "name": "Markup: Deletion",
      "scope": "markup.deleted",
      "settings": {
        "background": "#ffdddd",
        "foreground": "#e8dcc6"
      }
    },
    {
      "name": "Markup: Emphasis",
      "scope": "markup.italic",
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup: Error",
      "scope": "markup.error",
      "settings": {
        "foreground": "#e76f51"
      }
    },
    {
      "name": "Markup: Insertion",
      "scope": "markup.inserted",
      "settings": {
        "background": "#ddffdd",
        "foreground": "#e8dcc6"
      }
    },
    {
      "name": "Markup: Output",
      "scope": ["markup.output", "markup.raw"],
      "settings": {
        "foreground": "#8e8067"
      }
    },
    {
      "name": "Markup: Prompt",
      "scope": "markup.prompt",
      "settings": {
        "foreground": "#6a5d48"
      }
    },
    {
      "name": "Markup: Heading",
      "scope": "markup.heading",
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup: Strong",
      "scope": "markup.bold",
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup: Traceback",
      "scope": "markup.traceback",
      "settings": {
        "foreground": "#e76f51"
      }
    },
    {
      "name": "Markup: Underline",
      "scope": "markup.underline",
      "settings": {
        "fontStyle": "underline"
      }
    }
  ]
}

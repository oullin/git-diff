{
    "name": "@git-diff/domain",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./diff": {
            "types": "./dist/diff/index.d.ts",
            "default": "./dist/diff/index.js"
        },
        "./auth": {
            "types": "./dist/auth/index.d.ts",
            "default": "./dist/auth/index.js"
        },
        "./repo": {
            "types": "./dist/repo/index.d.ts",
            "default": "./dist/repo/index.js"
        },
        "./review": {
            "types": "./dist/review/index.d.ts",
            "default": "./dist/review/index.js"
        },
        "./branch": {
            "types": "./dist/branch/index.d.ts",
            "default": "./dist/branch/index.js"
        },
        "./pullrequest": {
            "types": "./dist/pullrequest/index.d.ts",
            "default": "./dist/pullrequest/index.js"
        },
        "./commit": {
            "types": "./dist/commit/index.d.ts",
            "default": "./dist/commit/index.js"
        },
        "./common": {
            "types": "./dist/common/index.d.ts",
            "default": "./dist/common/index.js"
        },
        "./preference": {
            "types": "./dist/preference/index.d.ts",
            "default": "./dist/preference/index.js"
        },
        "./system": {
            "types": "./dist/system/index.d.ts",
            "default": "./dist/system/index.js"
        },
        "./walkthrough": {
            "types": "./dist/walkthrough/index.d.ts",
            "default": "./dist/walkthrough/index.js"
        },
        "./settings": {
            "types": "./dist/settings/index.d.ts",
            "default": "./dist/settings/index.js"
        },
        "./launch": {
            "types": "./dist/launch/index.d.ts",
            "default": "./dist/launch/index.js"
        }
    },
    "scripts": {
        "build": "pnpm run format && tsc -p tsconfig.json",
        "format": "tsx ../../scripts/blank-lines.ts && oxfmt .",
        "format:check": "tsx ../../scripts/blank-lines.ts --check && oxfmt --check .",
        "lint": "oxlint ."
    },
    "dependencies": {
        "@pierre/diffs": "1.2.0-beta.6"
    },
    "devDependencies": {
        "tsx": "^4.21.0",
        "typescript": "^6.0.3"
    }
}

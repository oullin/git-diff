{
    "$schema": "https://turborepo.dev/schema.json",
    "ui": "stream",
    "cacheDir": "storage/.cache/turbo",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["dist/**", "dist-electron/**"]
        },
        "test": {
            "dependsOn": ["build"],
            "outputs": []
        },
        "dev": {
            "dependsOn": ["^build"],
            "cache": false,
            "persistent": true
        },
        "lint": {
            "outputs": []
        }
    }
}
